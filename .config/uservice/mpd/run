#!/bin/sh
exec 2>&1

# Dynamically set user session variables so MPD can connect to PipeWire
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"

# Force MPD to stay in the foreground, output logs, and use your config
exec mpd --no-daemon --stdout "$HOME/.config/mpd/mpd.conf" ${OPTS:-}

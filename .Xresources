Xft.antialias:	1
Xft.hinting:	1
Xft.autohint:	0
Xft.hintstyle:	hintslight
Xft.rgba:	rgb
Xft.lcdfilter:	lcddefault
Xcursor.theme: Bibata-Modern-Classic
Xcursor.size: 24

! Core Gruvbox Dark Palette Settings
*.background:  #32302f
*.foreground:  #ebdbb2
*.cursorColor: #ebdbb2

! Color definitions 0-15 (Gruvbox Standard - Green replaced with Blue/Yellow)
*.color0:      #32302f
*.color8:      #928374
*.color1:      #cc241d
*.color9:      #fb4934
*.color2:      #458588  ! Swapped to Gruvbox Regular Blue
*.color10:     #83a598  ! Swapped to Gruvbox Bright Blue
*.color3:      #d79921
*.color11:     #fabd2f
*.color4:      #458588
*.color12:     #83a598
*.color5:      #b16286
*.color13:     #d3869b
*.color6:      #d79921  ! Swapped to Gruvbox Regular Yellow
*.color14:     #fabd2f  ! Swapped to Gruvbox Bright Yellow
*.color7:      #a89984
*.color15:     #ebdbb2

! Explicit mapping hooks for vxwm
vxwm.normbgcolor:      #32302f
vxwm.normbordercolor:  #32302f
vxwm.normfgcolor:      #a89984

vxwm.selbgcolor:       #d65d0e
vxwm.selbordercolor:   #d65d0e
vxwm.selfgcolor:       #282828

